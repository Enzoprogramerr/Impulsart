---
interface Props {
  title: string;
  subtitle: string;
  image: string;
  imageAlt: string;
}

const {
  title,
  subtitle,
  image,
  imageAlt,
} = Astro.props;
---

<div>

  <h1>{title}</h1>

  <p>{subtitle}</p>

  
  <img
    src={image}
    alt={imageAlt}
  />
  <div class="hero__actions">
      <slot name="actions" />
    </div>

</div>